^SAMPLE = GSM6433585
!Sample_title = Primary TNBC, patient 9, section 1
!Sample_geo_accession = GSM6433585
!Sample_status = Public on Nov 02 2022
!Sample_submission_date = Aug 05 2022
!Sample_last_update_date = Nov 22 2022
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = TNBC tumor tissue
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: TNBC tumor tissue
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Fresh tissue was snap frozen in liquid nitrogen, then embedded in O.C.T. compound for cryosectioning. Two sections were obtained per patient sample and were mounted on 10x Genomics Visium Gene Expression slides.
!Sample_extract_protocol_ch1 = Libraries were constructed according to the 10x Genomics Spatial Gene Expression protocol. Briefly, tissues on slides were permeabilized to allow RNA to bind to oligonucleotides on the slide surface via polyA capture. cDNA was synthesized on-slide from immobilized RNA, then collected and used to generate sequencing libraries containing unique sample indices, as well as P5 and P7 primers for Illumina-compatible sequencing
!Sample_description = 10x Genomics spatial transcriptomics data
!Sample_data_processing = Raw sequencing data was processed through the spaceranger mkfastq pipeline, version 1.1.0 (10x Genomics), to create FASTQ files.
!Sample_data_processing = FASTQ files were processed through the spaceranger count pipeline, version 1.1.0 (10x Genomics), for demultiplexing, genome alignment, UMI counting, and spatial alignment.
!Sample_data_processing = Assembly: GRCh38
!Sample_data_processing = Supplementary files format and content: .h5 file contains matrix of raw expresssion data (UMI counts) per tissue-associated barcode for use in R or Python analysis
!Sample_data_processing = Supplementary files format and content: .json file contains scale factors relating pixels in tissue_hires_image.png to original full resolution tissue image
!Sample_data_processing = Supplementary files format and content: .png file contains downsampled tissue image
!Sample_data_processing = Supplementary files format and content: .csv file contains spatial cordinates for tissue barcodes
!Sample_data_processing = Supplementary files format and content: .cloupe file provides a user friendly interface for data exploration when opened with Loupe Browser (10x Genomics)
!Sample_data_processing = Library strategy: spatial transcriptomics (10x Genomics)
!Sample_platform_id = GPL24676
!Sample_contact_name = John,,Carpten
!Sample_contact_institute = University of Southern California
!Sample_contact_address = 1450 Biggy St
!Sample_contact_city = Los Angeles
!Sample_contact_state = CA
!Sample_contact_zip/postal_code = 90033
!Sample_contact_country = USA
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = other
!Sample_library_source = transcriptomic
!Sample_library_strategy = OTHER
